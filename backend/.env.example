# Local development uses an embedded SQLite file automatically -- you don't
# need Turso credentials just to run `npm run dev`.
# In production, set these two so the app talks to your Turso database instead:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

ADMIN_PASSWORD=
# ^ Only used ONCE, on first boot, to create the initial "admin" owner
# account (bcrypt-hashed into the database). After that first boot, this
# variable is no longer read for login -- accounts and passwords live in
# the database. You can remove this variable after the first successful
# deploy; keep a copy somewhere safe in case you ever need to rebuild the
# database from scratch.
ADMIN_JWT_SECRET=
NODE_ENV=production
GMAIL_USER=
GMAIL_PASS=
NOTIFY_EMAIL=
# Optional — where "Forgot password" recovery emails are sent. Defaults to pis.abuja@gmail.com if unset.
ADMIN_RECOVERY_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
